<script>
// Dynamic Section dropdown linked to Department
function updateSectionFilter() {
    const deptSelect = document.getElementById('deptSelect');
    const sectSelect = document.getElementById('sectionSelect');
    if (!deptSelect || !sectSelect) return;

    const selectedDept = deptSelect.value;
    const options = sectSelect.querySelectorAll('option');

    let currentValStillValid = false;

    options.forEach(opt => {
        if (!opt.value) {
            opt.style.display = 'block'; // "-- Semua Bagian --"
            return;
        }
        const optDept = opt.getAttribute('data-dept');
        if (!selectedDept || optDept === selectedDept) {
            opt.style.display = 'block';
            if (opt.value === sectSelect.value) {
                currentValStillValid = true;
            }
        } else {
            opt.style.display = 'none';
        }
    });

    if (!currentValStillValid && sectSelect.value !== '') {
        sectSelect.value = '';
    }
}

document.addEventListener('DOMContentLoaded', updateSectionFilter);
</script>

