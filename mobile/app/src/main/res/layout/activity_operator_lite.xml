<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9"
    android:orientation="vertical">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOperatorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Operator: -"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvShiftLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shift: -"
                android:textColor="#D97706"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPendingSyncBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pending_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Pending: 0"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnSos"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="SOS Emergency"
            app:srcCompat="@android:drawable/ic_dialog_alert"
            app:tint="#EF4444" />

        <ImageButton
            android:id="@+id/btnLogout"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Logout"
            app:srcCompat="@android:drawable/ic_lock_power_off"
            app:tint="#64748B" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CBD5E1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- STATION SELECTOR -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:strokeColor="#CBD5E1"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="STASIUN KERJA SCANNER (DEPARTEMEN PABRIK)"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerStation"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="#F8FAFC"
                    android:spinnerMode="dropdown" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CONTEXTUAL DEPARTMENT PARAMETERS CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDeptParams"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#F8FAFC"
            app:cardCornerRadius="8dp"
            app:strokeColor="#94A3B8"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tvParamTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="PARAMETER STASIUN"
                    android:textColor="#334155"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Mixing / Calendering Params -->
                <LinearLayout
                    android:id="@+id/layoutMixingParams"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="visible">

                    <Spinner
                        android:id="@+id/spinnerCompound"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="2"
                        android:background="#FFFFFF" />

                    <EditText
                        android:id="@+id/etParamWeight"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="#FFFFFF"
                        android:hint="Kg (50.0)"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="8dp"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Building Params -->
                <LinearLayout
                    android:id="@+id/layoutBuildingParams"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <Spinner
                        android:id="@+id/spinnerSpecSize"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="2"
                        android:background="#FFFFFF" />

                    <EditText
                        android:id="@+id/etBuildingMachine"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="#FFFFFF"
                        android:hint="TBM-01"
                        android:inputType="text"
                        android:paddingHorizontal="8dp"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Curing Params -->
                <LinearLayout
                    android:id="@+id/layoutCuringParams"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <Spinner
                        android:id="@+id/spinnerCavity"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="#FFFFFF" />

                    <Spinner
                        android:id="@+id/spinnerCuringDefect"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="2"
                        android:background="#FFFFFF" />
                </LinearLayout>

                <!-- Final Inspection Params -->
                <LinearLayout
                    android:id="@+id/layoutInspectionParams"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <Spinner
                        android:id="@+id/spinnerQcGrade"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="#FFFFFF" />

                    <EditText
                        android:id="@+id/etInspectionDefect"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="2"
                        android:background="#FFFFFF"
                        android:hint="Catatan Defect / Cacat"
                        android:inputType="text"
                        android:paddingHorizontal="8dp"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Warehouse Smart Rack Params -->
                <LinearLayout
                    android:id="@+id/layoutWarehouseParams"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etTargetRack"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="#FFFFFF"
                            android:hint="Lokasi Rak (Contoh: RAK-A01)"
                            android:inputType="textCapCharacters"
                            android:paddingHorizontal="8dp"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCheckRack"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:backgroundTint="#059669"
                            android:text="CEK RAK"
                            android:textSize="11sp"
                            app:cornerRadius="4dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRackValidation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Status Rak: Masukkan kode rak untuk verifikasi"
                        android:textColor="#059669"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SCANNER INPUT CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:strokeColor="#2563EB"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="INPUT PEMINDAI BARCODE (PDT SCAN)"
                    android:textColor="#2563EB"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etBarcodeScan"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:background="#F8FAFC"
                        android:hint="Scan atau ketik barcode..."
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:paddingHorizontal="10dp"
                        android:singleLine="true"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubmitScan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="#2563EB"
                        android:text="SIMPAN SCAN"
                        android:textSize="12sp"
                        app:cornerRadius="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSyncNow"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="SINKRON"
                        android:textColor="#10B981"
                        app:cornerRadius="6dp"
                        app:strokeColor="#10B981" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- LAST SCAN SUCCESS CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLastScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="#D1FAE5"
            app:cardCornerRadius="8dp"
            app:strokeColor="#10B981"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvScanTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SCAN BERHASIL (LOCAL ROOM DB)"
                    android:textColor="#065F46"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvScanDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Barcode: -"
                    android:textColor="#0F172A"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Riwayat Scan PDT (Local Room Storage)"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvScanHistory"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

    </LinearLayout>
</LinearLayout>
