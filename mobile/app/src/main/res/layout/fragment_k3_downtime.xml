<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="PUSAT TANGGAP DARURAT K3 MEDIS &amp; DOWNTIME"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- SOS EMERGENCY TRIGGER CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FEF2F2"
            app:cardCornerRadius="8dp"
            app:strokeColor="#EF4444"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PANGGILAN DARURAT AMBULANS PABRIK"
                    android:textColor="#991B1B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etSosLocation"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:background="#FFFFFF"
                    android:hint="Lokasi Insiden (misal: Curing Press Line A)"
                    android:paddingHorizontal="10dp"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etSosCondition"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="8dp"
                    android:background="#FFFFFF"
                    android:hint="Kondisi Korban / Deskripsi Insiden"
                    android:paddingHorizontal="10dp"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTriggerSos"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:backgroundTint="#EF4444"
                    android:text="KIRIM PANGGILAN DARURAT K3 (SOS)"
                    android:textSize="12sp"
                    app:cornerRadius="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ACTIVE EMERGENCY RESPONSE CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:strokeColor="#CBD5E1"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STATUS PENANGANAN INSIDEN AKTIF"
                    android:textColor="#0F172A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAmbulanceStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:text="Status: Memuat status panggilan..."
                    android:textColor="#475569"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOnSite"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="#F59E0B"
                        android:text="TIBA DI TKP (ON SITE)"
                        android:textSize="11sp"
                        app:cornerRadius="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCompleteSos"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="#10B981"
                        android:text="SELESAI (COMPLETED)"
                        android:textSize="11sp"
                        app:cornerRadius="6dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- DOWNTIME REPORTING CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:strokeColor="#CBD5E1"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="PELAPORAN MESIN BREAKDOWN / DOWNTIME"
                    android:textColor="#0F172A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etMachineCode"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginBottom="6dp"
                    android:background="#F8FAFC"
                    android:hint="Kode Mesin (misal: BANBURY-01, TBM-05)"
                    android:inputType="text"
                    android:paddingHorizontal="10dp"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etDowntimeDescription"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginBottom="8dp"
                    android:background="#F8FAFC"
                    android:hint="Keterangan Hambatan / Kerusakan"
                    android:inputType="text"
                    android:paddingHorizontal="10dp"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReportDowntime"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:backgroundTint="#2563EB"
                    android:text="KIRIM LAPORAN DOWNTIME"
                    android:textSize="12sp"
                    app:cornerRadius="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
