<?php
$pageTitle = 'SCADA Monitoring';
require_once __DIR__ . '/includes/header.php';

$pdo = Database::getConnection();

// Parameters
$selectedPeriod = $_GET['period'] ?? 'hourly'; // hourly, daily, monthly
$selectedShift = $_GET['shift_filter'] ?? 'all'; // all, 1, 2, 3
$selectedDept = $_GET['dept'] ?? 'ALL';
$selectedMetric = $_GET['metric'] ?? 'total'; // total, pass, reject, shift1, shift2, shift3

// Departments for filter
$departments = $pdo->query("SELECT id, code, name FROM departments ORDER BY id")->fetchAll();

// Calculate SCADA KPIs for current day/period
$whereClauses = ["1=1"];
$params = [];

if ($selectedDept !== 'ALL') {
    $whereClauses[] = "dept_id = ?";
    $params[] = $selectedDept;
}

$whereSql = implode(" AND ", $whereClauses);

// Production counts
$kpiStmt = $pdo->prepare("
    SELECT 
        COUNT(*) as total_output,
        SUM(CASE WHEN quality_status = 'PASS' THEN 1 ELSE 0 END) as pass_count,
        SUM(CASE WHEN quality_status = 'REJECT' THEN 1 ELSE 0 END) as reject_count,
        SUM(CASE WHEN quality_status = 'REPAIR' THEN 1 ELSE 0 END) as repair_count,
        SUM(CASE WHEN shift = 'Shift 1' THEN 1 ELSE 0 END) as shift1_count,
        SUM(CASE WHEN shift = 'Shift 2' THEN 1 ELSE 0 END) as shift2_count,
        SUM(CASE WHEN shift = 'Shift 3' THEN 1 ELSE 0 END) as shift3_count
    FROM production_scada_logs
    WHERE log_date = CURRENT_DATE AND {$whereSql}
");
$kpiStmt->execute($params);
$kpi = $kpiStmt->fetch();

$total = (int)($kpi['total_output'] ?? 0);
$pass = (int)($kpi['pass_count'] ?? 0);
$reject = (int)($kpi['reject_count'] ?? 0);
$repair = (int)($kpi['repair_count'] ?? 0);
$shift1 = (int)($kpi['shift1_count'] ?? 0);
$shift2 = (int)($kpi['shift2_count'] ?? 0);
$shift3 = (int)($kpi['shift3_count'] ?? 0);
$passRate = $total > 0 ? round(($pass / $total) * 100, 1) : 100.0;

// Query for hourly/daily/monthly trend
if ($selectedPeriod === 'hourly') {
    // 24 hours of today
    $trendStmt = $pdo->prepare("
        SELECT 
            log_hour as label_num,
            COUNT(*) as total_qty,
            SUM(CASE WHEN quality_status = 'PASS' THEN 1 ELSE 0 END) as pass_qty,
            SUM(CASE WHEN quality_status = 'REJECT' THEN 1 ELSE 0 END) as reject_qty
        FROM production_scada_logs
        WHERE log_date = CURRENT_DATE AND {$whereSql}
        GROUP BY log_hour
        ORDER BY log_hour ASC
    ");
    $trendStmt->execute($params);
    $rawTrend = $trendStmt->fetchAll(PDO::FETCH_KEY_PAIR | PDO::FETCH_GROUP);
} elseif ($selectedPeriod === 'daily') {
    // Last 14 days
    $trendStmt = $pdo->prepare("
        SELECT 
            TO_CHAR(log_date, 'DD/MM') as label_text,
            COUNT(*) as total_qty,
            SUM(CASE WHEN quality_status = 'PASS' THEN 1 ELSE 0 END) as pass_qty,
            SUM(CASE WHEN quality_status = 'REJECT' THEN 1 ELSE 0 END) as reject_qty
        FROM production_scada_logs
        WHERE log_date >= CURRENT_DATE - INTERVAL '14 days' AND {$whereSql}
        GROUP BY log_date
        ORDER BY log_date ASC
    ");
    $trendStmt->execute($params);
    $trendRows = $trendStmt->fetchAll();
} else {
    // Monthly (last 6 months)
    $trendStmt = $pdo->prepare("
        SELECT 
            TO_CHAR(log_date, 'Mon YYYY') as label_text,
            COUNT(*) as total_qty,
            SUM(CASE WHEN quality_status = 'PASS' THEN 1 ELSE 0 END) as pass_qty,
            SUM(CASE WHEN quality_status = 'REJECT' THEN 1 ELSE 0 END) as reject_qty
        FROM production_scada_logs
        WHERE log_date >= CURRENT_DATE - INTERVAL '6 months' AND {$whereSql}
        GROUP BY TO_CHAR(log_date, 'Mon YYYY'), DATE_TRUNC('month', log_date)
        ORDER BY DATE_TRUNC('month', log_date) ASC
    ");
    $trendStmt->execute($params);
    $trendRows = $trendStmt->fetchAll();
}

// Recent SCADA logs for table
$recentLogsStmt = $pdo->prepare("
    SELECT psl.*, d.name as dept_name 
    FROM production_scada_logs psl
    LEFT JOIN departments d ON psl.dept_id = d.code
    WHERE {$whereSql}
    ORDER BY psl.created_at DESC
    LIMIT 25
");
$recentLogsStmt->execute($params);
$recentLogs = $recentLogsStmt->fetchAll();
?>

<!-- SCADA Period & Dept Filter Controls -->
<div class="card" style="padding: 14px 20px; margin-bottom: 20px;">
    <form method="GET" action="scada.php" id="scadaFilterForm" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
        <input type="hidden" name="metric" id="metricInput" value="<?= htmlspecialchars($selectedMetric) ?>">
        <input type="hidden" name="shift_filter" id="shiftInput" value="<?= htmlspecialchars($selectedShift) ?>">

