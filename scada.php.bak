                <?php foreach ($departments as $d): ?>
                    <option value="<?= $d['code'] ?>" <?= $selectedDept === $d['code'] ? 'selected' : '' ?>>
                        <?= htmlspecialchars($d['name']) ?> (<?= $d['code'] ?>)
